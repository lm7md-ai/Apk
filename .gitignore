# Gradle
.gradle/
build/
out/
classes/

# Android Studio / IntelliJ
.idea/
*.iml
*.iws
*.ipr
captures/
.navigation/
kotlin-js-store/

# Kotlin
.kotlin/

# Compiled shell APKs are generated into app assets by the
# :shell-webview:packageWebviewShell / :shell-python:packagePythonShell
# Gradle tasks during every build (see app/build.gradle.kts).
app/src/main/assets/shells/

# Provisioned Python runtime for the python shell (downloaded on demand
# via :shell-python:downloadPythonRuntime).
shell-python/src/main/assets/python_runtime/

# Keystore / signing material (never commit)
*.jks
*.p12
*.keystore
*.pem
*.pass

# Logs / OS
*.log
.DS_Store
Thumbs.db

# Local configuration
local.properties

# ARM64 aapt2 runtime, downloaded at factory build time by the
# downloadAapt2Runtime task and packaged as jniLibs/arm64-v8a/libaapt2.so.
app/src/main/jniLibs/
